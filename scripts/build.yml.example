name: build-and-publish

# 触发条件：
#   - 推送到 main 分支 → 构建并推送 :latest 与 :main
#   - 打 v* 标签        → 构建并推送语义化版本标签（如 :1.0.0、:1.0、:latest）
#   - 手动触发          → 可自定义标签
on:
  push:
    branches: [main]
    tags: ['v*']
  pull_request:
    branches: [main]
  workflow_dispatch:
    inputs:
      tag:
        description: '额外的自定义镜像标签（可选）'
        required: false
        default: ''

# 只有推送镜像时才需要写 packages 权限；PR 只做构建验证。
permissions:
  contents: read
  packages: write

env:
  REGISTRY: ghcr.io

jobs:
  # ---------------------------------------------------------------------------
  # 第一步：跑测试。测试不过就不构建镜像，避免推出去一个坏的镜像。
  # ---------------------------------------------------------------------------
  test:
    runs-on: ubuntu-latest
    steps:
      - name: 检出代码
        uses: actions/checkout@v4

      - name: 安装 Go
        uses: actions/setup-go@v5
        with:
          go-version: '1.24'
          cache: true

      - name: 下载依赖
        run: go mod download

      - name: 代码格式检查
        run: |
          unformatted=$(gofmt -l .)
          if [ -n "$unformatted" ]; then
            echo "以下文件未格式化，请运行 gofmt -w .："
            echo "$unformatted"
            exit 1
          fi

      - name: 静态检查
        run: go vet ./...

      - name: 单元测试
        run: go test -count=1 -v ./...

  # ---------------------------------------------------------------------------
  # 第二步：构建多架构镜像并推送到 GHCR。
  # 仅在非 PR 时推送；PR 只验证能否构建成功。
  # ---------------------------------------------------------------------------
  build:
    needs: test
    runs-on: ubuntu-latest
    steps:
      - name: 检出代码
        uses: actions/checkout@v4

      # GHCR 要求镜像路径全小写，而 github.repository 会保留仓库所有者的大小写
      # （本仓库是 PeACE2323/bt-traffic-guard）。这里显式转成小写，
      # 否则推送到 ghcr.io/PeACE2323/... 会被拒绝。
      - name: 计算小写的镜像名
        id: repo
        run: echo "image=${GITHUB_REPOSITORY,,}" >> "$GITHUB_OUTPUT"

      - name: 设置 QEMU（用于构建 arm64 镜像）
        uses: docker/setup-qemu-action@v3

      - name: 设置 Buildx
        uses: docker/setup-buildx-action@v3

      - name: 登录 GHCR
        if: github.event_name != 'pull_request'
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: 生成镜像标签与元数据
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ env.REGISTRY }}/${{ steps.repo.outputs.image }}
          tags: |
            type=ref,event=branch
            type=ref,event=pr
            type=semver,pattern={{version}}
            type=semver,pattern={{major}}.{{minor}}
            type=semver,pattern={{major}}
            type=raw,value=latest,enable={{is_default_branch}}
            type=raw,value=${{ github.event.inputs.tag }},enable=${{ github.event.inputs.tag != '' }}

      - name: 构建并推送
        uses: docker/build-push-action@v6
        with:
          context: .
          # 支持 amd64 与 arm64，覆盖群晖/树莓派等 ARM 设备
          platforms: linux/amd64,linux/arm64
          push: ${{ github.event_name != 'pull_request' }}
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          build-args: |
            VERSION=${{ github.ref_name }}
          # GitHub Actions 缓存，显著加快重复构建
          cache-from: type=gha
          cache-to: type=gha,mode=max
          provenance: false
