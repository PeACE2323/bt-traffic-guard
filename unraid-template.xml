<?xml version="1.0"?>
<!--
  Unraid Docker 模板

  ===========================================================================
  镜像已发布在 GHCR，安装时【无需任何本地构建】
  ===========================================================================

    ghcr.io/peace2323/bt-traffic-guard:latest

  支持 linux/amd64 与 linux/arm64，匿名可拉取（不需要 docker login）。

  如果你确实想用本地构建的版本，把下方 <Repository> 改成
  本地镜像名 bt-traffic-guard:latest 并先执行：

    git clone https://github.com/PeACE2323/bt-traffic-guard.git
    cd bt-traffic-guard && bash scripts/build-image.sh
  ===========================================================================

  安装方式（任选其一）：
  1. Unraid 网页 → Docker → Add Container → 右上角切换到「XML」粘贴本文件内容
  2. 把本文件放到 /boot/config/plugins/dockerMan/templates-user/ 下，
     然后在 Docker → Add Container 的 Template 下拉框里选择 my-bt-traffic-guard

  部署后访问 http://<你的Unraid IP>:8080 即可打开监控面板。

  首次使用提醒：
  - 默认生成的示例下载器与限速策略都是【禁用】状态，
    需要在面板「配置」页里确认并手动启用。
  - 下载器地址不要填 127.0.0.1（容器里那是它自己），
    bridge 模式下请填 Unraid 的局域网 IP。
  - 容器时区务必填对，它决定「自然日」从几点开始统计。
-->
<Container version="2">
  <Name>bt-traffic-guard</Name>
  <!-- GHCR 上的预构建镜像。注意镜像名必须全小写。 -->
  <Repository>ghcr.io/peace2323/bt-traffic-guard:latest</Repository>
  <Registry>https://github.com/PeACE2323/bt-traffic-guard/pkgs/container/bt-traffic-guard</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/PeACE2323/bt-traffic-guard/issues</Support>
  <Project>https://github.com/PeACE2323/bt-traffic-guard</Project>
  <Overview>
    BT 上传流量监控与自动限速。
    持续采集 qBittorrent / Transmission 的上传速度与累计流量（区分 IPv4 / IPv6），
    当在自定义周期（如每天/每周/每月）内上传总量达到阈值时，自动下发上传限速；
    周期结束后自动解除。自带 Web 面板，可实时查看曲线、手动解除限速、在线改配置。

    【重要】所有配置都可以在网页上完成，不需要在这里预先填写连接信息。
    启动后打开 Web 面板 →「配置」标签页 → 填写下载器地址与凭据即可。

    支持 qBittorrent 5.2.0+ 的 API Key 认证（推荐，不会触发 IP 封禁），
    也兼容旧版本的用户名密码登录。
  </Overview>
  <Category>Network:Web Tools:Utilities</Category>
  <WebUI>http://[IP]:[PORT:8080]</WebUI>
  <TemplateURL/>
  <Icon/>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>

  <Config Name="WebUI 端口" Target="8080" Default="8080" Mode="tcp"
          Description="监控面板访问端口。部署后打开 http://[你的Unraid IP]:8080"
          Type="Port" Display="always" Required="true" Mask="false">8080</Config>

  <Config Name="配置目录" Target="/config" Default="/mnt/user/appdata/bt-traffic-guard/config"
          Mode="rw" Description="存放 config.yaml。首次启动会自动生成一份带注释的默认配置。"
          Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/bt-traffic-guard/config</Config>

  <Config Name="数据目录" Target="/data" Default="/mnt/user/appdata/bt-traffic-guard/data"
          Mode="rw" Description="存放运行数据。"
          Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/bt-traffic-guard/data</Config>

  <Config Name="时区" Target="TZ" Default="Asia/Shanghai" Mode=""
          Description="影响「自然日/自然周/自然月」周期边界的计算，请设置正确。例如 Asia/Shanghai、Asia/Hong_Kong、UTC。"
          Type="Variable" Display="always" Required="true" Mask="false">Asia/Shanghai</Config>

  <Config Name="日志级别" Target="BTG_LOG_LEVEL" Default="info" Mode=""
          Description="debug / info / warn / error。排查问题时用 debug。"
          Type="Variable" Display="advanced" Required="false" Mask="false">info</Config>

  <!-- =======================================================================
       以下连接信息【全部留空即可】。
       启动后在 Web 面板的「配置」标签页填写更直观，改完立即生效、不用重启容器。

       只有在你希望「用环境变量强制覆盖配置文件」时才需要填。
       注意：环境变量优先级高于 config.yaml，
       填了之后在网页上修改对应项不会生效。
       ======================================================================= -->

  <Config Name="【可选】qBittorrent 地址" Target="BTG_QBITTORRENT_URL" Default="" Mode=""
          Description="留空即可，启动后在 Web 面板里填写。
若要用环境变量覆盖，填例如 http://192.168.1.10:8080。
容器使用 bridge 网络时不能填 127.0.0.1（那指向容器自身），请填 Unraid 的局域网 IP。"
          Type="Variable" Display="advanced" Required="false" Mask="false"></Config>

  <Config Name="【可选】qBittorrent API Key" Target="BTG_QBITTORRENT_API_KEY" Default="" Mode=""
          Description="留空即可，启动后在 Web 面板里填写。
qBittorrent 5.2.0 及以上版本推荐用这个：在「设置 → WebUI → API Key」点击生成，
复制 qbt_ 开头的字符串填进来。这是无状态认证，不会触发登录失败导致的 IP 封禁。
填了它之后下面的用户名密码会被忽略。"
          Type="Variable" Display="advanced" Required="false" Mask="true"></Config>

  <Config Name="【可选】qBittorrent 用户名" Target="BTG_QBITTORRENT_USERNAME" Default="" Mode=""
          Description="留空即可。适用于没有 API Key 的旧版本（5.2.0 以下）。"
          Type="Variable" Display="advanced" Required="false" Mask="false"></Config>

  <Config Name="【可选】qBittorrent 密码" Target="BTG_QBITTORRENT_PASSWORD" Default="" Mode=""
          Description="留空即可。适用于没有 API Key 的旧版本（5.2.0 以下）。"
          Type="Variable" Display="advanced" Required="false" Mask="true"></Config>

  <Config Name="【可选】Transmission 地址" Target="BTG_TRANSMISSION_URL" Default="" Mode=""
          Description="留空即可。填根地址即可，程序会自动补 /transmission/rpc。
注意 Transmission 不支持 API Key，只能用用户名密码。"
          Type="Variable" Display="advanced" Required="false" Mask="false"></Config>

  <Config Name="【可选】Transmission 用户名" Target="BTG_TRANSMISSION_USERNAME" Default="" Mode=""
          Description="留空即可。若 Transmission 开启了 RPC 认证则填写。"
          Type="Variable" Display="advanced" Required="false" Mask="false"></Config>

  <Config Name="【可选】Transmission 密码" Target="BTG_TRANSMISSION_PASSWORD" Default="" Mode=""
          Description="留空即可。若 Transmission 开启了 RPC 认证则填写。"
          Type="Variable" Display="advanced" Required="false" Mask="true"></Config>

  <Config Name="【可选】面板访问密码" Target="BTG_WEB_PASSWORD" Default="" Mode=""
          Description="留空则不开认证，也可以在 Web 面板的「配置 → 通用与通知」里开启。
强烈建议在可被外网访问的环境下设置此项。"
          Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
</Container>
